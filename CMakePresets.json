{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "OWFAX_WARNINGS_AS_ERRORS": "ON" }
    },
    {
      "name": "dev",
      "displayName": "Development (Ninja, Debug)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release (Ninja)",
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "msvc-x64",
      "displayName": "Windows x64 (Visual Studio)",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "msvc-x86",
      "displayName": "Windows x86 (Visual Studio)",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "linux-armhf",
      "displayName": "Linux armhf cross (Raspberry Pi 32-bit)",
      "inherits": "release",
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-armhf.cmake"
    },
    {
      "name": "android-arm64",
      "displayName": "Android arm64-v8a (API 21)",
      "inherits": "release",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-21",
        "OWFAX_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "android-armv7",
      "displayName": "Android armeabi-v7a (API 21)",
      "inherits": "android-arm64",
      "cacheVariables": { "ANDROID_ABI": "armeabi-v7a" }
    }
  ],
  "buildPresets": [
    { "name": "dev", "configurePreset": "dev" },
    { "name": "release", "configurePreset": "release" },
    { "name": "msvc-x64", "configurePreset": "msvc-x64", "configuration": "Release" },
    { "name": "msvc-x86", "configurePreset": "msvc-x86", "configuration": "Release" },
    { "name": "linux-armhf", "configurePreset": "linux-armhf" },
    { "name": "android-arm64", "configurePreset": "android-arm64" },
    { "name": "android-armv7", "configurePreset": "android-armv7" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } }
  ]
}
